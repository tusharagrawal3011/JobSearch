# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys or personal data.

# ============ LLM provider chain ============
# Ordered fallback: tries each provider left-to-right; per provider it retries
# LLM_MAX_RETRIES times with exponential backoff, then falls through to the next.
# Providers are registered in backend/llm/providers.py (ollama|gemini|anthropic|openai).
LLM_CHAIN=gemini,ollama
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=30
LLM_VERBOSE=1

# ---- Gemini (free tier covers a personal-scale search; https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_SMART=gemini-2.5-flash
GEMINI_DISABLE_THINKING_FAST=1

# ---- Ollama (local, free — great as offline fallback; https://ollama.com) ----
# `ollama pull qwen2.5:7b` (fast) and `qwen2.5:14b` (smart) are good picks.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FAST=llama3
OLLAMA_MODEL_SMART=llama3
OLLAMA_NUM_CTX=8192

# ---- Anthropic (optional — add 'anthropic' to LLM_CHAIN to use) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-sonnet-5
CLAUDE_MODEL_SMART=claude-opus-4-8

# ---- OpenAI / OpenAI-compatible (optional; set OPENAI_BASE_URL for Groq/Together/vLLM) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o

# ============ Your identity / profile ============
OWNER_NAME=Your Name
OWNER_FIRST_NAME=Your
OWNER_LAST_NAME=Name
OWNER_EMAIL=you@example.com
OWNER_PHONE=
OWNER_LINKEDIN=linkedin.com/in/your-handle
OWNER_GITHUB=github.com/your-handle
OWNER_LOCATION=Your City, Country
# One line describing your target roles — used by the Area Scout web search + classifier.
OWNER_PROFILE=backend / full-stack software engineer (e.g. Go, Node.js, distributed systems, AI)

# ============ Job discovery filters ============
# A posting must match one of these role keywords (whole-word) to be picked up.
KEYWORD_FILTERS=go,golang,node,backend,sde,agentic,llm
# Locations you'll consider ('remote' is always allowed).
LOCATION_FILTERS=bengaluru,bangalore,hyderabad,pune,remote,india
# Remote job boards (official public APIs) to poll. Options: remoteok, remotive, arbeitnow.
REMOTE_BOARDS=remoteok,remotive,arbeitnow

# ============ Gmail API ============
# 1) Create a Google Cloud project, enable the Gmail API.
# 2) Create an OAuth client (Desktop app), download the JSON as credentials.json here.
# Scopes requested: gmail.readonly (parse your job-alert emails) + gmail.compose
# (create outreach DRAFTS). NEVER gmail.send.
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_JSON=token.json
# Job-alert sender domains the Email Parser reads (set up these alerts yourself so they
# email your inbox). Add linkedin.com, wellfound.com, instahyre.com, etc. as you like.
EMAIL_ALERT_WINDOW_HOURS=48
ALERT_SENDER_DOMAINS=naukri.com,indeed.com,cutshort.io

# ============ Resume rendering ============
# 'pdflatex' (needs a local LaTeX install like MiKTeX/TeX Live) or 'manual' (writes the
# tailored .tex for you to compile on Overleaf).
RESUME_RENDER_MODE=manual
PDFLATEX_BIN=pdflatex
# Provide your own resume as Jake-template LaTeX (see resume_go.sample.tex).
RESUME_GO_PDF=resume_go.pdf
RESUME_NODE_PDF=resume_node.pdf
RESUME_GO_TEX=resume_go.tex
RESUME_NODE_TEX=resume_node.tex

# ============ Playwright ============
PLAYWRIGHT_HEADED=1

# ============ Database & dashboard API ============
JOB_AGENT_DB=job_agent.db
API_HOST=127.0.0.1
API_PORT=8000

# ============ Seed ============
COMPANY_TRACKER_XLSX=company_tracker.xlsx
